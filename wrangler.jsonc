{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campusmart",
  "compatibility_date": "2026-11-13",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "routes": [
    {
      "pattern": "campusmart.online/*",
      "zone_name": "campusmart.online",
      "custom_domain": true
    },
    {
      "pattern": "www.campusmart.online/*",
      "zone_name": "campusmart.online",
      "custom_domain": true
    }
  ]
}
